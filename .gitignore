# Secrets — never commit private keys
claude_github_account_key

# JetBrains IDE (local, machine-specific)
.idea/

# Claude Code local tooling config (local, machine-specific) — MAIS pas les skills du projet
# (.claude/skills/), qui doivent être commités pour être réutilisables d'une session à l'autre.
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db
*.zip

# CA locale (proxy/antivirus TLS-inspecting) pour builds Docker sur ce poste — jamais dans l'image de prod
docker/local-ca/*.crt

# Prisma 7 generated client (regenerated at build time, not committed)
packages/db/generated/

# Données du Postgres embarqué local (scripts/local-test-db.mjs) — jetable, jamais commité
.local-pgdata/

# Future Node/Next.js app (stack decided in doc/technique/spec.md)
node_modules/
.env
.env.local
.env.*.local
dist/
.next/
